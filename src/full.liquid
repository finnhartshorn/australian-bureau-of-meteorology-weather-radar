      - "Cairns, QLD": "19"
      - "Canberra (Captains Flat), NSW": "40"
      - "Carnarvon, WA": "114"
      - "Ceduna, SA": "33"
      - "Dampier, WA": "15"
      - "Darwin (Berrimah), NT": "63"
      - "Emerald, QLD": "72"
      - "Esperance, WA": "32"
      - "Geraldton, WA": "06"
      - "Giles, WA": "44"
      - "Gladstone, QLD": "23"
