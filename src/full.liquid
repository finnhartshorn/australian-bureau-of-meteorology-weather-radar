{% endif %}

{% assign range_digit = "3" %}
{% case effective_km %}
  {% when "64" %} {% assign range_digit = "4" %}
  {% when "128" %} {% assign range_digit = "3" %}
  {% when "256" %} {% assign range_digit = "2" %}
  {% when "512" %} {% assign range_digit = "1" %}
{% endcase %}

{% assign radar_code = "IDR" | append: site_prefix | append: range_digit %}

<div class="view view--full">
  <img class="image image-dither" src="https://www.bom.gov.au/radar/{{ radar_code }}.gif" alt="{{ site_label }} radar, {{ effective_km }} km" style="width: 100%; height: 100%; object-fit: contain;">
</div>
